# ==========================================================================
# 스마트에코 쾌적교실 - Vercel & 로컬 환경변수 템플릿 (.env.example)
# Vercel 대시보드 -> Settings -> Environment Variables 에 등록하세요.
# ==========================================================================

# 1. 기상청 API 키 (공공데이터포털 발급 키)
WEATHER_API_KEY=YOUR_KMA_API_KEY_HERE

# 2. 나이스(NEIS) 교육행정정보시스템 API 키 (나이스 오픈 API 발급 키)
NEIS_API_KEY=YOUR_NEIS_API_KEY_HERE

# 3. 기본 기상청 격자 좌표 (제주여자고등학교 기본값: NX 52, NY 38)
LOCATION_NX=52
LOCATION_NY=38
