{
  "version": 2,
  "builds": [
    {
      "src": "weather.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/coord-to-grid",
      "dest": "/weather.js?type=coord-to-grid"
    },
    {
      "src": "/api/weather",
      "dest": "/weather.js?type=current-weather"
    },
    {
      "src": "/api/weekly-weather",
      "dest": "/weather.js?type=weekly-weather"
    },
    {
      "src": "/api/school-schedule",
      "dest": "/weather.js?type=school-schedule"
    },
    {
      "src": "/api/school-search",
      "dest": "/weather.js?type=school-search"
    },
    {
      "src": "/api/class-count",
      "dest": "/weather.js?type=class-count"
    },
    {
      "src": "/api/schedule",
      "dest": "/weather.js?type=schedule"
    },
    {
      "src": "/style.css",
      "dest": "/style.css"
    },
    {
      "src": "/app.js",
      "dest": "/app.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
